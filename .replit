modules = ["python"]

entrypoint = "app.py"

[nix]
channel = "stable-24_05"

[env]
PIP_BREAK_SYSTEM_PACKAGES = "1"
PIP_USER = "1"
PIP_CONFIG_FILE = "pip.conf"
PATH = "/home/runner/.local/bin:/home/runner/workspace/.local/bin:${PATH}"

[packager]
language = "python3"

[packager.features]
packageSearch = true
guessImports = true

run = ["bash", "scripts/start_streamlit.sh"]

[deployment]
run = ["bash", "scripts/start_streamlit.sh"]
deploymentTarget = "autoscale"
