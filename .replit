modules = ["python"]

entrypoint = "app.py"

[nix]
channel = "stable-24_05"

[env]
PIP_BREAK_SYSTEM_PACKAGES = "1"
PIP_USER = "1"
PIP_CONFIG_FILE = "pip.conf"
PYTHONUSERBASE = "/home/runner/.local"
PATH = "/home/runner/.local/bin:/home/runner/workspace/.venv/bin:/home/runner/workspace/.local/bin:${PATH}"

[packager]
language = "python3"

[packager.features]
packageSearch = true
guessImports = true

run = ["bash", "scripts/start_streamlit.sh"]

[deployment]
build = ["bash", "-c", "python3 -m venv .venv && PIP_USER=0 PIP_CONFIG_FILE= .venv/bin/pip install -r requirements.txt"]
run = ["bash", "scripts/start_streamlit.sh"]
deploymentTarget = "autoscale"
